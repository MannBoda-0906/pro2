# StudyTube AI Backend Configuration

# Server Port
PORT=5000

# Google Gemini API Key
# Get a key at: https://aistudio.google.com
GEMINI_API_KEY=

# Preferred Gemini Model (Defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Client Origin (CORS)
CLIENT_URL=http://localhost:5173

# Optional: Supabase configuration (if used)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
