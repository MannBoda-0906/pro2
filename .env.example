# StudyTube AI Configuration

# Server Port
PORT=5000

# Google Gemini API Key (Optional: App includes fallback demo mode and heuristic mode if not provided)
# Get a free key at: https://aistudio.google.com
GEMINI_API_KEY=

# Preferred Gemini Model (Defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Supabase Configuration (Optional: App falls back to local storage if not provided)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Client Base URL (for CORS)
CLIENT_URL=http://localhost:5173
